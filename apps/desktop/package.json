{
  "name": "@hinov/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "Hinov Group",
  "description": "ERP Modulaire & Multi-Services Hinov Group - Version Desktop",
  "scripts": {
    "dev": "tsc && electron .",
    "dev:live": "concurrently \"pnpm --filter @hinov/web dev\" \"wait-on http://localhost:3000 && tsc && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build": "tsc",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --x64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.hinovgroup.erp",
    "productName": "Hinov ERP",
    "directories": {
      "output": "../../dist-electron-packages"
    },
    "files": [
      "dist-electron/**/*",
      "../web/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hinov ERP",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "@hinov/core": "workspace:*"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.2"
  }
}
