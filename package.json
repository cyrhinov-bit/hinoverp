{
  "name": "hinov-suivi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ERP Interne Modulaire et Multi-Services Hinov ERP",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@hinov/web",
    "dev:desktop": "turbo run dev --filter=@hinov/desktop",
    "dev:mobile": "turbo run dev --filter=@hinov/mobile",
    "build": "turbo run build",
    "build:web": "pnpm --filter @hinov/core build && pnpm --filter @hinov/web build",
    "build:desktop": "pnpm --filter @hinov/core build && pnpm --filter @hinov/web build && pnpm --filter @hinov/desktop build",
    "dist:desktop": "pnpm build:desktop && pnpm --filter @hinov/desktop dist:win",
    "dist:desktop:portable": "pnpm build:desktop && pnpm --filter @hinov/desktop dist:portable",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "supabase": "^2.117.0",
    "turbo": "^2.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.5.2"
}
